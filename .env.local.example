# =============================================================================
# StockViz Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Supabase ------------------------------------------------------------------
# For local development with Docker, see supabase/.env.local.example
# For hosted Supabase, use your project credentials from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy alias supported temporarily: NEXT_PUBLIC_SUPABASE_ANON_KEY
# Service role key - required for server-side operations (cache cleanup, etc.)
# DO NOT commit this to version control. Get from Supabase Dashboard > Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=your-postgres-connection-string

# --- AI / Gemini ---------------------------------------------------------------
# Used by the root AI summary provider. Leave GEMINI_API_KEY blank to use the
# built-in fallback summary generator instead.
GEMINI_API_KEY=your-gemini-api-key
# Optional: set to `auto` (default), `gemini`, or `fallback`
# AI_SUMMARY_PROVIDER=auto

# --- Market Data ---------------------------------------------------------------
# Primary market-data key used by the migrated search/fundamentals/sentiment services.
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
# Optional secondary providers used by the multi-source manager when available.
FINNHUB_API_KEY=your-finnhub-api-key
TWELVE_DATA_API_KEY=your-twelve-data-api-key
# Legacy alias supported temporarily for Alpha Vantage only: MARKET_DATA_API_KEY

# --- Application ---------------------------------------------------------------
# Optional: override the default port for local development
# PORT=3000
